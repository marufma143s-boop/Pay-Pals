+    fun addAdminDepositMethod(method: String) {
+        val current = _depositMethods.value.toMutableList()
+        if (!current.contains(method)) {
+            current.add(method)
+            com.example.data.FirebaseRealtimeDbManager.updateAdminSetting("deposit_methods", current)
+        }
+    }
